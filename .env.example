# Core Rails runtime
RAILS_ENV=production
PORT=3000
HOST=localhost
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
PIDFILE=tmp/pids/server.pid

# App URLs and session secrets
BASE_URL=http://localhost
SECRET_KEY_BASE=your_secret_key_base_here

# PostgreSQL credentials consumed by config/database.yml
DATABASE_HOST=db
DATABASE_USERNAME=upwork
DATABASE_PASSWORD=upwork_local_postgres

# Redis queue/cache connection used by Sidekiq and Action Cable
REDIS_URL=redis://redis:6379/0

# Jobs-only remote PostgreSQL mirror used by Sidekiq
REMOTE_JOBS_DATABASE_HOST=
REMOTE_JOBS_DATABASE_PORT=5432
REMOTE_JOBS_DATABASE_NAME=
REMOTE_JOBS_DATABASE_USERNAME=
REMOTE_JOBS_DATABASE_PASSWORD=
REMOTE_JOBS_DATABASE_SSLMODE=require

# Upwork OAuth settings
UPWORK_CLIENT_ID=your_upwork_client_id
UPWORK_CLIENT_SECRET=your_upwork_client_secret
UPWORK_RATE_LIMIT_PER_SECOND=8
UPWORK_RATE_LIMIT_PER_MINUTE=240
UPWORK_API_RETRY_MAX=5
UPWORK_API_RETRY_BASE_SECONDS=0.75
UPWORK_API_RETRY_MAX_SECONDS=30
UPWORK_MAX_PAGES_PER_TAG=3
UPWORK_MAX_JOBS_PER_TAG=150
UPWORK_MAX_PAGES_PER_PROPOSAL_STATUS=3
UPWORK_MAX_PROPOSALS_PER_STATUS=100

# Optional app bootstrap user for admin seed
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=your_admin_password

# Optional app bootstrap user for normal (non-admin) seed
NORMAL_SEED_EMAIL=
NORMAL_SEED_PASSWORD=
